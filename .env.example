# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Lista de chaves Gemini para rodízio automático na Vercel (separadas por vírgula)
# No painel da Vercel: Project Settings > Environment Variables > GEMINI_API_KEYS
GEMINI_API_KEYS="AIzaSy1...,AIzaSy2...,AIzaSy3..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
